import java.util.*;

class Main {
    public static void main(String[] args) {
        
     Scanner sc = new Scanner(System.in);
     int n = sc.nextInt();
     
     char [] dp = new char[n];
     
     Arrays.fill(dp,'-');
  if (n % 2 == 1) {
           
            dp[n / 2] = '=';
        } else {
            
            dp[n / 2 - 1] = '=';
            dp[n / 2] = '=';
        }
  
     
     System.out.print(new String(dp));
    }
}
